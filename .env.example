# Database
MONGO_URI=mongodb://localhost:27017/skillswaptn

# Mail config
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# AI Services
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
REPLICATE_API_TOKEN=your-replicate-api-token

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_WORKERS_AI_API_KEY=your-cloudflare-api-key

# Sightengine Image Moderation
SIGHTENGINE_API_USER=your-sightengine-user
SIGHTENGINE_API_SECRET=your-sightengine-secret
